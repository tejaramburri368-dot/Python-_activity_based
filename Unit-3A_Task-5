
A = [[1, 2],
     [3, 4]]

B = [[5, 6],
     [7, 8]]

print("Matrix A:")
for row in A:
    print(row)

print("Matrix B:")
for row in B:
    print(row)


print("Matrix Addition:")
for i in range(2):
    for j in range(2):
        print(A[i][j] + B[i][j], end=" ")
    print()

print("Matrix Subtraction:")
for i in range(2):
    for j in range(2):
        print(A[i][j] - B[i][j], end=" ")
    print()

print("Matrix Multiplication:")
for i in range(2):
    for j in range(2):
        sum = 0
        for k in range(2):
            sum += A[i][k] * B[k][j]
        print(sum, end=" ")
    print()